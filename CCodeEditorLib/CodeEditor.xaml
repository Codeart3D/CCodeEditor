<UserControl x:Class="CCodeEditorLib.CodeEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CCodeEditorLib"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Loaded="UserControl_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <Border Background="#333" Height="1"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#222222"/>
            <Border Grid.Column="1" Background="#272727"/>

            <Grid Name="griLine">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="10"/>
                </Grid.ColumnDefinitions>
            </Grid>

            <RichTextBox Grid.Column="1" Background="Transparent" Foreground="LightGray" FontSize="13" BorderThickness="0" Margin="0,5" FontFamily="Consolas"
                     AcceptsReturn="True" Name="tbxCode" TextChanged="tbxCode_TextChanged" PreviewKeyDown="tbxCode_PreviewKeyDown" SizeChanged="TbxCode_SizeChanged"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" IsUndoEnabled="False" SelectionChanged="TbxCode_SelectionChanged"
                         ScrollViewer.ScrollChanged="TbxCode_ScrollChanged">
                <RichTextBox.Resources>
                    <Style TargetType="{x:Type Paragraph}">
                        <Setter Property="Margin" Value="0"/>
                    </Style>
                </RichTextBox.Resources>

                <RichTextBox.CaretBrush>
                    <SolidColorBrush Color="White"/>
                </RichTextBox.CaretBrush>
            </RichTextBox>

            <Popup Grid.Column="1" Width="150" Height="auto" MaxHeight="200" MinHeight="50" StaysOpen="False" IsOpen="False" Name="popSuggestion" Placement="AbsolutePoint">
                <ListBox Background="#222" BorderThickness="1" BorderBrush="#111" Name="lstKeyword" HorizontalContentAlignment="Stretch" SelectionChanged="LstKeyword_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Background="#222" Name="griKeyItem" MouseDown="GriKeyItem_MouseDown">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="5"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>

                                <Image Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" Source="{Binding Icon}" IsHitTestVisible="False"/>
                                <TextBlock Grid.Column="2" Text="{Binding Key}" Foreground="WhiteSmoke" IsHitTestVisible="False"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Popup>
        </Grid>

        <Border Grid.Row="2" Background="#222" BorderThickness="0,1,0,0" BorderBrush="#333">
                <TextBox Text="Error(s) : " Foreground="IndianRed" Margin="5" Height="40" Visibility="Visible" Name="tbkError" IsReadOnly="True" 
                         HorizontalAlignment="Left" VerticalAlignment="Top" BorderThickness="0" BorderBrush="Transparent" Background="Transparent" 
                         HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" TextWrapping="WrapWithOverflow"/>
        </Border>
    </Grid>
</UserControl>
